#!/usr/bin/env bash
# Builds dist/Me.app (release) with the `me` CLI inside it.
#
#   script/bundle-macos             # host architecture
#   script/bundle-macos --universal # arm64 + x86_64
#   script/bundle-macos --install   # also copy to /Applications and link the CLI
#
# Signs ad hoc unless CODESIGN_IDENTITY is set (e.g. "Developer ID Application: …").
set -euo pipefail
cd "$(dirname "$0")/.."

universal=false
install=false
for arg in "$@"; do
  case "$arg" in
    --universal) universal=true ;;
    --install) install=true ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
# The build number is master's commit count: CI's releases are tagged
# build-<n>, and the app compares its own number to the latest one to
# update itself.
build=$(git rev-list --count HEAD 2>/dev/null || echo 1)
commit=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
export ME_BUILD=$build ME_COMMIT=$commit

target=${CARGO_TARGET_DIR:-target}
if $universal; then
  rustup target add aarch64-apple-darwin x86_64-apple-darwin >/dev/null
  cargo build --release -p me-app -p me-cli --target aarch64-apple-darwin
  cargo build --release -p me-app -p me-cli --target x86_64-apple-darwin
  mkdir -p "$target/universal"
  for bin in me-app me; do
    lipo -create -output "$target/universal/$bin" \
      "$target/aarch64-apple-darwin/release/$bin" "$target/x86_64-apple-darwin/release/$bin"
  done
  out=$target/universal
else
  cargo build --release -p me-app -p me-cli
  out=$target/release
fi

app=dist/Me.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources/bin"
cp "$out/me-app" "$app/Contents/MacOS/Me"
cp "$out/me" "$app/Contents/Resources/bin/me"
sed -e "s/@VERSION@/$version/" -e "s/@BUILD@/$build/" packaging/macos/Info.plist > "$app/Contents/Info.plist"
script/make-icns assets/logo/app-icon-1024.png "$app/Contents/Resources/AppIcon.icns"

# macOS 26 takes the app icon from Assets.car, named by CFBundleIconName,
# and switches it between light, dark, clear and tinted; older macOS uses
# AppIcon.icns. Compiling the car needs macOS 26 and Xcode 26, so CI does it
# on a macOS 26 runner and passes it in ME_APP_ICON_CAR; elsewhere it's
# compiled here, and left out (with a warning) where it can't be.
car=${ME_APP_ICON_CAR:-}
if [ -z "$car" ]; then
  icon_out=$(mktemp -d)
  if script/compile-app-icon "$icon_out"; then
    car=$icon_out/Assets.car
  fi
fi
if [ -n "$car" ]; then
  cp "$car" "$app/Contents/Resources/Assets.car"
  /usr/libexec/PlistBuddy -c "Add :CFBundleIconName string AppIcon" "$app/Contents/Info.plist"
else
  echo "warning: no macOS 26 app icon, so no dark icon; the app has AppIcon.icns only" >&2
fi

codesign --force --options runtime --sign "${CODESIGN_IDENTITY:--}" "$app/Contents/Resources/bin/me"
codesign --force --options runtime --sign "${CODESIGN_IDENTITY:--}" "$app"
echo "Built $app ($version, build $build)"

if $install; then
  rm -rf /Applications/Me.app
  cp -R "$app" /Applications/
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f /Applications/Me.app
  if ln -sf /Applications/Me.app/Contents/Resources/bin/me /usr/local/bin/me 2>/dev/null; then
    echo "Linked /usr/local/bin/me"
  else
    echo "Run: sudo ln -sf /Applications/Me.app/Contents/Resources/bin/me /usr/local/bin/me"
  fi
  # The app was called Editor before; point out leftovers of that install.
  if [ -d /Applications/Editor.app ] && grep -q com.erkie.editor /Applications/Editor.app/Contents/Info.plist 2>/dev/null; then
    echo "Note: /Applications/Editor.app is the old build of this app; you can delete it (and /usr/local/bin/editor)."
  fi
fi
