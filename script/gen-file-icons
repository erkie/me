#!/usr/bin/env python3
"""Generates file-type icons from the Seti UI icon theme (MIT, the theme
VS Code and Cursor use by default).

    git clone --depth 1 https://github.com/jesseweed/seti-ui /tmp/seti-ui
    script/gen-file-icons /tmp/seti-ui

Writes crates/app/src/file_icons/table.rs and copies the SVGs it needs to
assets/file-icons/.
"""

import re
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT_RS = ROOT / "crates/app/src/file_icons/table.rs"
OUT_SVG = ROOT / "assets/file-icons"

COLORS = {"blue", "grey", "grey-light", "green", "ignore", "orange", "pink",
          "purple", "red", "white", "yellow"}


def main(seti: Path) -> None:
    mapping = (seti / "styles/components/icons/mapping.less").read_text()
    rule = re.compile(r'^\.icon-(set|partial)\("([^"]+)",\s*"([^"]+)",\s*@([a-z-]+)\);', re.M)
    rules = []
    for kind, pattern, icon, color in rule.findall(mapping):
        if color == "seti-primary":
            color = "blue"
        if color not in COLORS:
            raise SystemExit(f"unknown color @{color} for {pattern}")
        if not (seti / "icons" / f"{icon}.svg").exists():
            print(f"skipping {pattern}: no icons/{icon}.svg", file=sys.stderr)
            continue
        rules.append((kind, pattern, icon, color))

    icons = sorted({icon for _, _, icon, _ in rules} | {"default"})
    if OUT_SVG.exists():
        shutil.rmtree(OUT_SVG)
    OUT_SVG.mkdir(parents=True)
    for icon in icons:
        shutil.copy(seti / "icons" / f"{icon}.svg", OUT_SVG / f"{icon}.svg")
    shutil.copy(seti / "LICENSE.md", OUT_SVG / "LICENSE.md")

    def rust_color(name: str) -> str:
        return "".join(part.capitalize() for part in name.split("-"))

    lines = [
        "// @generated by script/gen-file-icons from the Seti UI icon theme",
        "// (https://github.com/jesseweed/seti-ui, MIT). Do not edit by hand.",
        "",
        "use super::{IconColor::*, Match::*, Rule};",
        "",
        "/// Rules in Seti's order; a later match wins, as in its stylesheet.",
        "pub(super) static RULES: &[Rule] = &[",
    ]
    for kind, pattern, icon, color in rules:
        m = "EndsWith" if kind == "set" else "Contains"
        lines.append(f'    ({m}("{pattern}"), "{icon}", {rust_color(color)}),')
    lines += ["];", "", "pub(super) fn svg(icon: &str) -> Option<&'static [u8]> {", "    Some(match icon {"]
    for icon in icons:
        lines.append(f'        "{icon}" => include_bytes!("../../../../assets/file-icons/{icon}.svg"),')
    lines += ["        _ => return None,", "    })", "}", ""]
    OUT_RS.parent.mkdir(parents=True, exist_ok=True)
    OUT_RS.write_text("\n".join(lines))
    print(f"{len(rules)} rules, {len(icons)} icons")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit(__doc__)
    main(Path(sys.argv[1]))
